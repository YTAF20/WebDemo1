# ============================================================
# ProTint Auto — Environment Variables
# Copy this file to .env.local and fill in the values.
# NEVER commit .env.local to git.
# ============================================================

# ── Google Calendar (Service Account) ─────────────────────
# 1. Go to console.cloud.google.com → New Project
# 2. Enable "Google Calendar API"
# 3. Create a Service Account → Keys → Add Key → JSON
# 4. Copy email and private_key from the downloaded JSON file
# 5. Share your Google Calendar with the service account email
#    (give it "Make changes to events" / Editor permission)

GOOGLE_SERVICE_ACCOUNT_EMAIL=your-service-account@your-project.iam.gserviceaccount.com
GOOGLE_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\nYOUR_KEY_HERE\n-----END RSA PRIVATE KEY-----\n"

# The calendar ID to use. Use "primary" for the default calendar,
# or find the ID in Google Calendar → Settings → [Calendar] → Calendar ID
GOOGLE_CALENDAR_ID=primary

# ── Gmail SMTP (for sending emails) ───────────────────────
# 1. Enable 2-Step Verification on your Google account
# 2. Go to myaccount.google.com → Security → App Passwords
# 3. Create an App Password for "Mail"
# 4. Paste the 16-character password below (no spaces)

GMAIL_USER=yourbusiness@gmail.com
GMAIL_APP_PASSWORD=xxxxxxxxxxxxxxxxxxxx

# ── Business Info (shown in emails & footer) ──────────────
NEXT_PUBLIC_BUSINESS_NAME=ProTint Auto
NEXT_PUBLIC_BUSINESS_PHONE=(555) 123-4567
NEXT_PUBLIC_BUSINESS_ADDRESS=123 Main St, City, ST 00000
NEXT_PUBLIC_BUSINESS_EMAIL=info@protintauto.com

# ── Cron Security ─────────────────────────────────────────
# A secret token to protect the /api/cron/reminders endpoint.
# Generate one with: openssl rand -base64 32
# In Vercel, add this same secret to your project env vars AND
# to the cron job header in vercel.json.
CRON_SECRET=replace-with-a-long-random-secret
